{
  "name": "products",
  "required": ["id", "price", "rating", "stock", "discountPercentage"],
  "critical": ["price", "rating"],
  "ranges": {
    "price": [0, null],
    "rating": [0, 5],
    "stock": [0, null],
    "discountPercentage": [0, 100]
  },
  "preprocessing": {
    "encode": {
      "category": "label",
      "product_name": "onehot"
    }
},
  "model_class": "sklearn.cluster.DBSCAN", "model_params": { "eps": 0.5 } ,
  "unique": ["id"]
}